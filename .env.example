# Default: Claude Pro/Max via `claude login` (no Console credits).
# Set ANCIENT_USE_API_KEY=1 to bill a Console key instead.
# ANCIENT_USE_API_KEY=1
# ANTHROPIC_API_KEY=sk-ant-...
# Required only for multi-workspace (unscoped) API keys. Copy wrkspc_… from Console.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
#
# The Secret Shop. Cursor cannot pay the Claude Agent SDK.
# ANCIENT_AGENT_PROVIDER=claude   # or cursor — HUD /shop also switches this
# ANCIENT_BUYBACK=1               # auto-walk to Cursor when Claude is out of mana
# CURSOR_API_KEY=                 # optional; HUD "Open the ledger" mints one via browser login
ANCIENT_ROOT=/absolute/path/to/your/product-repos
WORKTREE_ROOT=/absolute/path/to/your/product-repos/.the-ancient
EVIDENCE_ROOT=/absolute/path/to/your/product-repos/.the-ancient/replays
# Folder names under ANCIENT_ROOT (defaults: api, app, admin)
# ANCIENT_API_DIR=api
# ANCIENT_APP_DIR=app
# ANCIENT_ADMIN_DIR=admin
# ANCIENT_BASE_BRANCH=main
# GitHub owner/name for The Field (issues are listed, never opened from here).
# ANCIENT_GH_OWNER=your-org
# ANCIENT_API_GITHUB=your-org/api
# ANCIENT_APP_GITHUB=your-org/app
# ANCIENT_ADMIN_GITHUB=your-org/admin
# Only needed for the standalone runner, not for `langgraph dev`
POSTGRES_URI=postgresql://localhost:5432/the_ancient
MAX_REVIEW_ROUNDS=3
# ANCIENT_PR_DRAFT=0
