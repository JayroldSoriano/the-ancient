# Default: Claude Pro/Max via `claude login` (no Console credits).
# Set BEENS_USE_API_KEY=1 to bill a Console key instead.
# BEENS_USE_API_KEY=1
# ANTHROPIC_API_KEY=sk-ant-...
# Required only for multi-workspace (unscoped) API keys. Copy wrkspc_… from Console.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
#
# The Secret Shop. Cursor cannot pay the Claude Agent SDK.
# BEENS_AGENT_PROVIDER=claude   # or cursor — HUD /shop also switches this
# BEENS_BUYBACK=1               # auto-walk to Cursor when Claude is out of mana
# CURSOR_API_KEY=               # optional; HUD "Open the ledger" mints one via browser login
BEENS_ROOT=/Users/jayrold/code/beens
WORKTREE_ROOT=/Users/jayrold/code/.beens-agents
EVIDENCE_ROOT=/Users/jayrold/code/.beens-agents/evidence
# Only needed for the standalone runner, not for `langgraph dev`
POSTGRES_URI=postgresql://localhost:5432/beens_agents
MAX_REVIEW_ROUNDS=3
# GitHub org that owns the three product repos (issues are listed, never opened from here).
# BEENS_GH_OWNER=Beens-App
